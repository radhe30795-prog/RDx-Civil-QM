# --- RDx Civil QM ---
# Copy to .env for local dev. On Render, set these in the dashboard (sync: false).

# TiDB Cloud Serverless (MySQL-compatible). Create a database named `qm`
# in your TiDB Cloud cluster, then paste the connection string:
#   mysql://<user>:<password>@<host>:4000/qm
DATABASE_URL=
# TiDB Cloud requires TLS
DB_SSL=true

PORT=3000
NODE_ENV=development
